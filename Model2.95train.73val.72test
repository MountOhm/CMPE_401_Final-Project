# 95% train - 73% val

# made a fter overfitting

# 3. Define Simple Neural Network Architecture with Regularization to prevent overfitting
model = models.Sequential([
    # Input layer and first Convolution block
    layers.Conv2D(32, (3, 3), activation='relu', input_shape=(128, 128, 3)),
    layers.BatchNormalization(),
    layers.MaxPooling2D((2, 2)),
    layers.Dropout(0.25),  # Prevents early memorization

    # Second Convolution block
    layers.Conv2D(64, (3, 3), activation='relu'),
    layers.BatchNormalization(),
    layers.MaxPooling2D((2, 2)),
    layers.Dropout(0.25),

    # Flatten 2D matrices to a 1D vector
    layers.Flatten(),

    # Dense/Fully Connected Layers with Dropout
    layers.Dense(64, activation='relu'),
    layers.BatchNormalization(),
    layers.Dropout(0.5),   # Heavy dropout on fully-connected layers to reduce overfitting
    layers.Dense(num_classes, activation='softmax')  # Output layer
])

# 4. Compile Model
model.compile(
    optimizer='adam',
    loss='categorical_crossentropy',
    metrics=['accuracy']
)

# Print structure
model.summary()
